{
  "id": "core",
  "description": "Language-neutral and English patterns (docs/03-PRIVACY-ENGINE.md §5.2). Regexes use only features common to ICU, JavaScript and Java.",
  "rules": [
    {
      "id": "email",
      "category": "contact",
      "subtype": "email",
      "confidence": "high",
      "regex": "(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}"
    },
    {
      "id": "url",
      "category": "contact",
      "subtype": "url",
      "confidence": "high",
      "validator": "url_identifying",
      "regex": "\\b(?:https?://|www\\.)[^\\s<>\"'()\\[\\]]*[^\\s<>\"'()\\[\\].,;:!?]"
    },
    {
      "id": "handle",
      "category": "contact",
      "subtype": "handle",
      "confidence": "high",
      "regex": "(?<![A-Za-z0-9._%+@/-])@[A-Za-z0-9_][A-Za-z0-9_.]{0,28}[A-Za-z0-9_]"
    },
    {
      "id": "phone",
      "category": "contact",
      "subtype": "phone",
      "confidence": "high",
      "validator": "phone",
      "regex": "(?<![\\w+])(?:\\+\\d{1,3}[\\s.-]?)?(?:\\(\\d{2,4}\\)[\\s.-]?)?\\d{2,4}(?:[\\s.-]?\\d{2,4}){1,4}(?![\\w])"
    },
    {
      "id": "card",
      "category": "id",
      "subtype": "card",
      "confidence": "high",
      "validator": "card",
      "regex": "(?<![\\d-])\\d(?:[ -]?\\d){12,18}(?![\\d-])"
    },
    {
      "id": "iban",
      "category": "id",
      "subtype": "iban",
      "confidence": "high",
      "validator": "iban",
      "shrink": true,
      "regex": "\\b[A-Z]{2}\\d{2}(?: ?[A-Z0-9]){11,30}\\b"
    },
    {
      "id": "ssn",
      "category": "id",
      "subtype": "ssn",
      "confidence": "high",
      "validator": "ssn",
      "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b"
    },
    {
      "id": "uk_ni",
      "category": "id",
      "subtype": "national_id",
      "confidence": "high",
      "validator": "uk_ni",
      "regex": "\\b[A-CEGHJ-PR-TW-Z]{2} ?\\d{2} ?\\d{2} ?\\d{2} ?[A-D]\\b"
    },
    {
      "id": "passport",
      "category": "id",
      "subtype": "passport",
      "confidence": "high",
      "validator": "has_digit",
      "regex": "\\b[A-Z0-9]{6,9}\\b",
      "context": {
        "words": [
          "passport"
        ],
        "before": 5,
        "after": 2,
        "required": true
      }
    },
    {
      "id": "reference",
      "category": "id",
      "subtype": "reference",
      "confidence": "medium",
      "validator": "has_digit",
      "caseInsensitive": true,
      "regex": "(?<![A-Za-z0-9-])#?[A-Za-z0-9][A-Za-z0-9-]{4,}[A-Za-z0-9](?![A-Za-z0-9-])",
      "context": {
        "words": [
          "account",
          "acct",
          "a/c",
          "policy",
          "claim",
          "case",
          "order",
          "ref",
          "reference",
          "invoice",
          "ticket",
          "booking",
          "confirmation",
          "member",
          "membership",
          "customer",
          "tracking",
          "loan",
          "contract",
          "application",
          "patient",
          "mrn",
          "employee",
          "student",
          "badge"
        ],
        "before": 5,
        "after": 2,
        "required": true
      }
    },
    {
      "id": "otp",
      "category": "secret",
      "subtype": "otp",
      "confidence": "high",
      "regex": "\\b\\d{4,8}\\b",
      "context": {
        "words": [
          "code",
          "otp",
          "verification",
          "passcode",
          "pin",
          "one-time",
          "one time",
          "security code",
          "2fa",
          "authentication"
        ],
        "before": 5,
        "after": 3,
        "required": true
      }
    },
    {
      "id": "password",
      "category": "secret",
      "subtype": "password",
      "confidence": "high",
      "caseInsensitive": true,
      "group": 1,
      "regex": "\\b(?:password|passwd|pwd|passcode)\\s*(?:is|was|:|=|-)\\s*[\"']?([^\\s\"']{4,64})"
    },
    {
      "id": "api_key",
      "category": "secret",
      "subtype": "api_key",
      "confidence": "high",
      "regex": "\\b(?:sk-[A-Za-z0-9_-]{16,}|AIza[0-9A-Za-z_-]{35}|gh[pousr]_[A-Za-z0-9]{36}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16})"
    },
    {
      "id": "high_entropy",
      "category": "secret",
      "subtype": "token",
      "confidence": "medium",
      "validator": "entropy_secret",
      "regex": "(?<![A-Za-z0-9+/_=-])[A-Za-z0-9+/_=-]{24,}(?![A-Za-z0-9+/_=-])"
    },
    {
      "id": "date_iso",
      "category": "date",
      "subtype": "date",
      "confidence": "medium",
      "context": {
        "words": [
          "born",
          "dob",
          "d.o.b",
          "date of birth",
          "birthday",
          "birth date",
          "birthdate"
        ],
        "before": 5,
        "after": 0,
        "required": false,
        "subtype": "dob",
        "confidence": "high"
      },
      "regex": "\\b\\d{4}-\\d{2}-\\d{2}\\b"
    },
    {
      "id": "date_numeric",
      "category": "date",
      "subtype": "date",
      "confidence": "medium",
      "context": {
        "words": [
          "born",
          "dob",
          "d.o.b",
          "date of birth",
          "birthday",
          "birth date",
          "birthdate"
        ],
        "before": 5,
        "after": 0,
        "required": false,
        "subtype": "dob",
        "confidence": "high"
      },
      "regex": "\\b\\d{1,2}[/.-]\\d{1,2}[/.-](?:\\d{4}|\\d{2})\\b"
    },
    {
      "id": "date_day_month",
      "category": "date",
      "subtype": "date",
      "confidence": "medium",
      "context": {
        "words": [
          "born",
          "dob",
          "d.o.b",
          "date of birth",
          "birthday",
          "birth date",
          "birthdate"
        ],
        "before": 5,
        "after": 0,
        "required": false,
        "subtype": "dob",
        "confidence": "high"
      },
      "regex": "\\b\\d{1,2}(?:st|nd|rd|th)? (?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|June?|July?|Aug(?:ust)?|Sept?(?:ember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?,? \\d{4}\\b"
    },
    {
      "id": "date_month_day",
      "category": "date",
      "subtype": "date",
      "confidence": "medium",
      "context": {
        "words": [
          "born",
          "dob",
          "d.o.b",
          "date of birth",
          "birthday",
          "birth date",
          "birthdate"
        ],
        "before": 5,
        "after": 0,
        "required": false,
        "subtype": "dob",
        "confidence": "high"
      },
      "regex": "\\b(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|June?|July?|Aug(?:ust)?|Sept?(?:ember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.? \\d{1,2}(?:st|nd|rd|th)?(?:,? \\d{4})?\\b"
    },
    {
      "id": "street_address",
      "category": "location",
      "subtype": "address",
      "confidence": "high",
      "regex": "\\b\\d{1,6}[A-Za-z]? (?:[A-Z][A-Za-z'.-]* ){1,4}(?:Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Lane|Ln|Drive|Dr|Court|Ct|Way|Place|Pl|Terrace|Ter|Parkway|Pkwy|Highway|Hwy|Circle|Cir|Square|Sq|Close|Crescent|Cres|Grove|Row|Mews)\\b\\.?(?:,? (?:Apt|Apartment|Unit|Suite|Ste|Flat|Floor|#)\\.? ?#?[A-Za-z0-9-]+)?"
    },
    {
      "id": "unit",
      "category": "location",
      "subtype": "unit",
      "confidence": "medium",
      "regex": "\\b(?:Apt|Apartment|Unit|Suite|Flat)\\.? ?#?\\d+[A-Za-z]?\\b"
    },
    {
      "id": "uk_postcode",
      "category": "location",
      "subtype": "postcode",
      "confidence": "medium",
      "regex": "\\b[A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2}\\b"
    },
    {
      "id": "us_zip",
      "category": "location",
      "subtype": "postcode",
      "confidence": "medium",
      "regex": "\\b(?:AL|AK|AZ|AR|CA|CO|CT|DE|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY|DC),? \\d{5}(?:-\\d{4})?\\b"
    },
    {
      "id": "licence_plate",
      "category": "id",
      "subtype": "plate",
      "confidence": "medium",
      "validator": "plate",
      "regex": "\\b[A-Z0-9]{2,4}[ -]?[A-Z0-9]{2,4}\\b",
      "context": {
        "words": [
          "plate",
          "licence plate",
          "license plate",
          "number plate",
          "reg",
          "registration",
          "vehicle"
        ],
        "before": 4,
        "after": 0,
        "required": true
      }
    }
  ]
}
