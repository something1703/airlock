{
  "name": "airlock-functions",
  "private": true,
  "description": "Airlock Cloud Functions (v2): stats aggregation, Sensitive Data Protection scan of SEALED text, delete-my-data.",
  "type": "module",
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --project demo-airlock --only firestore --config ../firebase/firebase.json \"vitest run\""
  },
  "dependencies": {
    "@google-cloud/dlp": "7.2.0",
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^22.0.0",
    "firebase": "13.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
